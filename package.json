{
  "name": "@makerping/javascript",
  "version": "0.1.0-beta.4",
  "description": "The JavaScript and TypeScript SDK for explicit MakerPing events, from servers and browsers.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://makerping.com/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makerping/makerping-javascript.git"
  },
  "bugs": {
    "url": "https://github.com/makerping/makerping-javascript/issues"
  },
  "keywords": [
    "makerping",
    "custom-events",
    "notifications",
    "javascript",
    "typescript",
    "cloudflare-workers"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/server.d.mts",
      "default": "./src/server.mjs"
    },
    "./server": {
      "types": "./src/server.d.mts",
      "default": "./src/server.mjs"
    },
    "./browser": {
      "types": "./src/browser.d.mts",
      "default": "./src/browser.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  }
}
